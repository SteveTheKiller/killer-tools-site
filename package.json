  "scripts": {
    "dev": "vite",
    "build": "node -e \"require('vue-tsc').run(require.resolve('@typescript/typescript6/lib/tsc'))\" -- --noEmit && cross-env NODE_OPTIONS=--max_old_space_size=4096 vite build && node generate-routes.mjs",
    "preview": "vite preview --port 5050",
    "test": "npm run test:unit",
    "test:unit": "vitest --environment jsdom",
    "test:e2e": "playwright test",
    "test:e2e:dev": "BASE_URL=http://localhost:5173 NO_WEB_SERVER=true playwright test",
    "coverage": "vitest run --coverage",
    "typecheck": "node -e \"require('vue-tsc').run(require.resolve('@typescript/typescript6/lib/tsc'))\" -- --noEmit -p tsconfig.vitest.json --composite false",
    "lint": "eslint src",
    "script:create:tool": "node scripts/create-tool.mjs",
    "script:create:ui": "hygen generator ui-component",
    "release": "node ./scripts/release.mjs"
  },
